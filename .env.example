# Copy to .env and fill in real values before running docker compose.
POSTGRES_PASSWORD=change-me
# HS512 needs at least 64 bytes.
JWT_SECRET=change-me-to-a-random-string-of-at-least-64-characters-for-hs512-signing
# Shared secret used to verify payment gateway webhooks.
PAYMENT_WEBHOOK_SECRET=change-me
# Optional SMTP settings for email notifications.
MAIL_ENABLED=false
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=no-reply@ipld11stars.com
